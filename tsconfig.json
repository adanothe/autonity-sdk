{
  "include": [
    "src/**/*"
  ],
  "compilerOptions": {
    "target": "es2016",                                  
    "module": "commonjs",                                
    "moduleResolution": "Node",                    
    "outDir": "./dist",                                   
    "esModuleInterop": true,                          
    "strict": true,                                      
    "skipLibCheck": true,
    "declaration": true,       
    "emitDeclarationOnly": false  
  }
}
