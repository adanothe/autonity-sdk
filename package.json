{
  "name": "autonity-sdk",
  "version": "0.4.6",
  "description": "NPM package for interacting with the Autonity network",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "require": "./dist/contracts/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.js"
    },
    "./typechain": {
      "types": "./dist/typechain/index.d.ts",
      "import": "./dist/typechain/index.js",
      "require": "./dist/typechain/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "types": [
        "./dist/types/index.d.ts"
      ],
      "contracts": [
        "./dist/contracts/index.d.ts"
      ],
      "core": [
        "./dist/core/index.d.ts"
      ],
      "typechain": [
        "./dist/typechain/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "ts-node test.ts",
    "type": "typechain --target ethers-v6 --out-dir src/typechain abi/*.json",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist"
  },
  "files": [
    "dist",
    "readme.md",
    "abi",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "keywords": [
    "ethereum",
    "ethers",
    "smart contract",
    "typescript",
    "web3",
    "sdk",
    "blockchain",
    "autonity",
    "oracle",
    "validator",
    "staking",
    "auctioneer",
    "defi"
  ],
  "author": "adanode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adanothe/autonity-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/adanothe/autonity-sdk/issues"
  },
  "homepage": "https://adanothe.github.io/autonity-sdk/",
  "peerDependencies": {
    "ethers": "^6.13.2"
  },
  "dependencies": {
    "ethers": "^6.13.2",
    "node-jq": "^6.1.0"
  },
  "devDependencies": {
    "@typechain/ethers-v6": "^0.5.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.123",
    "docusaurus-plugin-typedoc": "^1.4.2",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.1",
    "ts-morph": "^26.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typechain": "^8.3.2",
    "typedoc": "^0.28.10",
    "typedoc-plugin-markdown": "^4.8.1",
    "typescript": "^5.9.2"
  }
}
